<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vortex Cinema</title>
    <style>
        body { background-color: #1A1A1A; color: #C5A059; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; text-align: center; margin: 0; padding: 20px; }
        h1 { font-size: 2.5em; margin-bottom: 40px; }
        .movie-grid { display: flex; flex-wrap: wrap; justify-content: center; }
        .movie-card { margin: 15px; text-decoration: none; color: #fff; width: 200px; transition: transform 0.2s; background: #111; padding: 10px; border-radius: 8px; border: 1px solid #333; }
        .movie-card:hover { transform: scale(1.05); border: 1px solid #C5A059; }
        .movie-card img { width: 100%; border-radius: 4px; }
        .movie-card h3 { font-size: 16px; margin-top: 10px; min-height: 40px; }
        .movie-card .rating { color: #C5A059; font-size: 14px; margin-top: 5px; }
    </style>
</head>
<body>
    <h1>✦ Vortex Cinema ✦</h1>

    <div class="movie-grid">
        <% movies.forEach(movie => { %>
            <a href="/watch/<%= movie.id %>" class="movie-card">
                <% if (movie.poster_path) { %>
                    <img src="/proxy-image?path=<%= encodeURIComponent(movie.poster_path) %>" alt="<%= movie.title %>">
                <% } else { %>
                    <img src="https://via.placeholder.com/200x300?text=No+Poster" alt="No Poster">
                <% } %>
                <h3><%= movie.title %></h3>
                <div class="rating">⭐ <%= movie.vote_average ? movie.vote_average.toFixed(1) : 'N/A' %></div>
            </a>
        <% }) %>
    </div>
</body>
</html>