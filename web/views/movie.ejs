<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title><%= movie.title %></title>
    <style>
        body { background: #0d0d0d; color: #fff; font-family: sans-serif; text-align: center; padding: 20px; }
        .media-box { background: #000; border-radius: 12px; padding: 10px; max-width: 800px; margin: 0 auto; }
        iframe { width: 100%; height: 400px; border: none; border-radius: 8px; }
        .btn { margin-top: 20px; padding: 15px 30px; background: #C5A059; color: #000; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; }
    </style>
</head>
<body>
    <h1><%= movie.title %></h1>

    <div class="media-box">
        <% if (trailerKey) { %>
            <iframe src="https://www.youtube-nocookie.com/embed/<%= trailerKey %>" allowfullscreen></iframe>
        <% } else { %>
            <p>لا يتوفر تريلر</p>
        <% } %>
    </div>

    <button id="watchBtn" class="btn">🎬 شاهد الفيلم كاملاً (في المتصفح)</button>

    <!-- تحميل الـ SDK الخاص بديسكورد -->
    <script src="https://unpkg.com/@discord/embedded-app-sdk/dist/embedded-app-sdk.js"></script>
    <script>
        const discordSdk = new DiscordSDK('<%= clientId %>');

        document.getElementById('watchBtn').onclick = async () => {
            // هذا الأمر هو الوحيد المسموح به لفتح روابط خارجية من داخل الأكتيفيتي
            await discordSdk.commands.openExternalUrl({
                url: 'https://vidsrc.to/embed/movie/<%= movie.id %>'
            });
        };
    </script>
</body>
</html>