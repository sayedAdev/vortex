<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= movie.title %> | Vortex Cinema</title>
    <style>
        body { background-color: #0d0d0d; color: #fff; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 20px; }
        .container { max-width: 900px; margin: 0 auto; text-align: center; }
        h1 { color: #C5A059; margin-bottom: 20px; font-size: 2.2em; border-bottom: 2px solid #C5A059; display: inline-block; padding-bottom: 10px; }
        
        .media-box { background: #000; border-radius: 12px; padding: 10px; box-shadow: 0 0 20px rgba(197, 160, 89, 0.2); margin-bottom: 20px; }
        iframe { width: 100%; height: 500px; border-radius: 8px; }
        
        .actions { margin-top: 20px; display: flex; justify-content: center; gap: 15px; }
        .btn { padding: 12px 30px; border-radius: 6px; font-weight: bold; text-decoration: none; transition: 0.3s; cursor: pointer; border: none; }
        .watch-btn { background: #C5A059; color: #000; }
        .watch-btn:hover { background: #fff; }
        .ext-btn { background: #333; color: #fff; }
        
        .info { background: #1a1a1a; padding: 25px; border-radius: 12px; text-align: right; margin-top: 20px; border: 1px solid #333; }
        .poster { width: 180px; border-radius: 8px; float: right; margin-left: 20px; border: 2px solid #C5A059; }
    </style>
</head>
<body>
    <div class="container">
        <h1><%= movie.title %></h1>

        <!-- مشغل الفيديو -->
        <div class="media-box" id="player">
            <% if (trailerKey) { %>
                <iframe src="https://www.youtube-nocookie.com/embed/<%= trailerKey %>?autoplay=1&rel=0&modestbranding=1" 
                        allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" 
                        allowfullscreen></iframe>
            <% } else { %>
                <p style="padding: 100px;">لا يتوفر تريلر حالياً</p>
            <% } %>
        </div>

        <div class="actions">
            <!-- الزر ده بيحول الـ iframe لفيلم كامل -->
            <button onclick="playMovie()" class="btn watch-btn">🎬 ابدأ عرض الفيلم الآن</button>
            <a href="https://vidsrc.to/embed/movie/<%= movie.id %>" target="_blank" class="btn ext-btn">فتح في المتصفح</a>
        </div>

        <div class="info">
            <img src="/proxy-image?path=<%= encodeURIComponent(movie.poster_path) %>" class="poster">
            <p><strong>التقييم:</strong> ⭐ <%= movie.vote_average ? movie.vote_average.toFixed(1) : 'N/A' %></p>
            <p><strong>القصة:</strong> <%= movie.overview %></p>
        </div>
    </div>

    <script>
        function playMovie() {
            const player = document.getElementById('player');
            // تغيير الـ src بتاع الـ iframe لـ رابط الفيلم المباشر
            player.innerHTML = `<iframe src="https://vidsrc.to/embed/movie/<%= movie.id %>" 
                                allow="autoplay; fullscreen; encrypted-media" 
                                allowfullscreen></iframe>`;
        }
    </script>
</body>
</html>