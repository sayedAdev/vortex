<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= movie.title %> | Vortex Cinema</title>
    <style>
        body { background-color: #1A1A1A; color: #fff; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 20px; text-align: center; }
        .header h1 { color: #C5A059; margin-bottom: 10px; font-size: 2em; }
        .player-container { max-width: 800px; margin: 0 auto 30px auto; }
        .player-container iframe { width: 100%; height: 450px; border: none; border-radius: 8px; box-shadow: 0 0 15px rgba(197, 160, 89, 0.3); }
        .watch-btn { display: inline-block; margin-top: 20px; padding: 15px 40px; background: #C5A059; color: #1A1A1A; border: none; border-radius: 8px; font-size: 18px; font-weight: bold; cursor: pointer; }
        .details { max-width: 800px; margin: 20px auto; background: #111; padding: 20px; border-radius: 8px; border: 1px solid #C5A059; display: flex; gap: 20px; text-align: right; }
        .poster { width: 200px; border-radius: 8px; flex-shrink: 0; }
        .back-link { display: inline-block; margin-top: 20px; color: #C5A059; text-decoration: none; font-weight: bold; }
    </style>
    <!-- استدعاء أداة ديسكورد الرسمية -->
    <script src="https://cdn.jsdelivr.net/npm/@discord/embedded-app-sdk@1.0.2/dist/discord-embedded-app-sdk.min.js"></script>
</head>
<body>
    <div class="header">
        <h1>✦ <%= movie.title %> ✦</h1>
    </div>

    <div class="player-container">
        <% if (trailerKey) { %>
            <!-- التريلر الرسمي -->
            <iframe src="https://www.youtube.com/embed/<%= trailerKey %>" allowfullscreen frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
        <% } else { %>
            <p style="color: #C5A059; margin-top: 50px;">لا يتوفر تريلر لهذا الفيلم.</p>
        <% } %>
        
        <br>
        <!-- زر يستخدم أمر ديسكورد الرسمي لفتح المتصفح -->
        <button onclick="openMovie()" class="watch-btn">
            🎬 شاهد الفيلم كاملاً (افتح في المتصفح)
        </button>
    </div>

    <div class="details">
        <% if (movie.poster_path) { %>
            <img src="/proxy-image?path=<%= encodeURIComponent(movie.poster_path) %>" class="poster">
        <% } %>
        <div>
            <p><strong>تاريخ الإصدار:</strong> <%= movie.release_date || 'غير معروف' %></p>
            <p><strong>التقييم:</strong> ⭐ <%= movie.vote_average ? movie.vote_average.toFixed(1) : 'N/A' %></p>
            <p style="margin-top: 15px; line-height: 1.6;"><strong>القصة:</strong> <%= movie.overview || 'لا تتوفر تفاصيل لهذا الفيلم حالياً.' %></p>
        </div>
    </div>

    <a href="/" class="back-link">العودة للرئيسية</a>

    <script>
        // تهيئة ديسكورد SDK
        const sdk = new DiscordSDK('<%= clientId %>');
        sdk.ready().then(() => { console.log("Discord Activity is ready!"); }).catch(console.error);

        // الدالة التي تفتح الرابط في متصفح خارجي باستخدام أمر ديسكورد
        function openMovie() {
            const url = 'https://vidsrc.to/embed/movie/<%= movie.id %>';
            if (sdk && sdk.commands) {
                sdk.commands.openExternalLink(url);
            } else {
                window.open(url, '_blank');
            }
        }
    </script>
</body>
</html>