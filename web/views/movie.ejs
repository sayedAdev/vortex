<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= movie.title %> | Vortex Cinema</title>
    <style>
        /* إزالة كل الهوامش لجعل المشغل يأخذ كامل الشاشة */
        html, body {
            margin: 0; 
            padding: 0; 
            height: 100%; 
            overflow: hidden; 
            background-color: #000;
        }
        /* جعل المشغل يأخذ 100% من مساحة الـ Activity */
        .full-screen-player {
            width: 100%;
            height: 100%;
            border: none;
        }
        .details {
            position: absolute;
            top: 0;
            right: 0;
            width: 300px;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            color: #fff;
            padding: 20px;
            box-sizing: border-box;
            overflow-y: auto;
            text-align: right;
            z-index: 10;
            display: none; /* مخفية افتراضياً */
        }
        .toggle-btn {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 11;
            background: #C5A059;
            color: #1A1A1A;
            border: none;
            padding: 10px 15px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <!-- زر لإظهار/إخفاء تفاصيل الفيلم -->
    <button class="toggle-btn" onclick="toggleDetails()">تفاصيل الفيلم</button>

    <!-- المشغل يأخذ كامل الشاشة -->
    <iframe src="https://vidsrc.to/embed/movie/<%= movie.id %>" class="full-screen-player" allowfullscreen frameborder="0" allow="fullscreen; encrypted-media; autoplay; picture-in-picture"></iframe>

    <!-- تفاصيل الفيلم (تظهر كـ Overlay) -->
    <div class="details" id="details">
        <h1 style="color: #C5A059; font-size: 24px;"><%= movie.title %></h1>
        <p><strong>تاريخ الإصدار:</strong> <%= movie.release_date || 'غير معروف' %></p>
        <p><strong>التقييم:</strong> ⭐ <%= movie.vote_average ? movie.vote_average.toFixed(1) : 'N/A' %></p>
        <p style="margin-top: 15px; line-height: 1.6;"><strong>القصة:</strong> <%= movie.overview || 'لا تتوفر تفاصيل لهذا الفيلم حالياً.' %></p>
        <br>
        <a href="/" style="color: #C5A059; text-decoration: none; font-weight: bold;">العودة للبحث</a>
    </div>

    <script>
        function toggleDetails() {
            const details = document.getElementById('details');
            if (details.style.display === 'block') {
                details.style.display = 'none';
            } else {
                details.style.display = 'block';
            }
        }
    </script>
</body>
</html>