<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= movie.title %> | Vortex Cinema</title>
    <style>
        body { background-color: #1A1A1A; color: #fff; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 20px; text-align: center; }
        .header h1 { color: #C5A059; margin-bottom: 20px; font-size: 2em; }
        .player-container { max-width: 900px; margin: 0 auto; }
        video { width: 100%; height: auto; max-height: 600px; border: 2px solid #C5A059; border-radius: 8px; background: #000; }
        .details { max-width: 800px; margin: 20px auto; background: #111; padding: 20px; border-radius: 8px; border: 1px solid #C5A059; display: flex; gap: 20px; text-align: right; }
        .poster { width: 200px; border-radius: 8px; flex-shrink: 0; }
        .back-link { display: inline-block; margin-top: 20px; color: #C5A059; text-decoration: none; font-weight: bold; font-size: 18px; }
    </style>
</head>
<body>
    <div class="header">
        <h1>✦ <%= movie.title %> ✦</h1>
    </div>

    <div class="player-container">
        <video controls autoplay>
            <!-- قراءة الفيديو من رابط جوجل درايف -->
            <source src="<%= url %>" type="video/mp4">
            متصفحك لا يدعم تشغيل الفيديو.
        </video>
    </div>

    <div class="details">
        <% if (movie.poster_path) { %>
            <img src="/proxy-image?path=<%= encodeURIComponent(movie.poster_path) %>" class="poster">
        <% } %>
        <div>
            <p><strong>تاريخ الإصدار:</strong> <%= movie.release_date || 'غير معروف' %></p>
            <p><strong>التقييم:</strong> ⭐ <%= movie.vote_average ? movie.vote_average.toFixed(1) : 'N/A' %></p>
            <p style="margin-top: 15px; line-height: 1.6;"><strong>القصة:</strong> <%= movie.overview || 'لا تتوفر تفاصيل.' %></p>
        </div>
    </div>

    <a href="/" class="back-link">العودة لقائمة الأفلام</a>
</body>
</html>